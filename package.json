{
  "name": "erp-desktop",
  "version": "1.0.0",
  "description": "Modern Enterprise ERP Desktop Application",
  "main": "dist/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron dist/main.js\"",
    "dev:master": "npm run build:main && concurrently \"npm run dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron dist/main.js --is-master\"",
    "dev:client": "wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron dist/main.js --is-client",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron dist/main.js",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "package": "electron-builder",
    "start": "electron dist/main.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.10",
    "electron-updater": "^6.1.7",
    "express": "^5.2.1",
    "pdfjs-dist": "^5.4.624",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.2.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^5.12.8",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.10.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.erp.desktop",
    "productName": "ERP Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP Desktop",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "ERP-Desktop-Portable.exe"
    }
  }
}
